rules_version = '2';

// Espelho do Shakstory:
//  - workspaces/main: pasta dos administradores (e-mails da lista abaixo), pelo Google (GitHub Pages) ou pelo Cloudflare Access.
//  - mirrors/<e-mail>: pasta de cada usuário comum; só quem entrou com aquele mesmo e-mail (Google verificado, ou Access) lê e grava.
// Para autorizar outro administrador, acrescente o e-mail na lista abaixo e publique as regras.
// O plano (teste de 7 dias, econômico, premium, vip) NÃO fica aqui: é conferido pelos Workers, no D1.
service cloud.firestore {
  match /databases/{database}/documents {
    function emails() {
      return [
        'acpconsultorias@gmail.com',
        'antonyopintor@gmail.com'
      ];
    }
    function autorizado() {
      return request.auth != null
        && (
          // Entrada pelo Google (GitHub Pages)
          ('email' in request.auth.token && request.auth.token.email_verified == true && request.auth.token.email in emails())
          // Entrada pelo Cloudflare Access: o Worker confere o e-mail e assina a credencial com a claim mirrorEmail
          || ('mirrorEmail' in request.auth.token && request.auth.token.mirrorEmail in emails())
        );
    }
    function minhaPasta(email) {
      return request.auth != null
        && (
          ('email' in request.auth.token && request.auth.token.email_verified == true && request.auth.token.email.lower() == email)
          || ('mirrorEmail' in request.auth.token && request.auth.token.mirrorEmail.lower() == email)
        );
    }
    // Oferta válida do catálogo público: só plano, preço em centavos e link oficial Ton (HTTPS, domínio e formato fixos).
    // Nada de campos extras, preço zero ou negativo, nem link fora de payment-link-v3.ton.com.br.
    function ofertaValida(o) {
      return o is map
        && o.keys().hasOnly(['plan', 'priceCents', 'checkoutUrl'])
        && o.keys().hasAll(['plan', 'priceCents', 'checkoutUrl'])
        && o.plan in ['economico', 'premium', 'vip']
        && o.priceCents is int && o.priceCents > 0 && o.priceCents <= 100000000
        && o.checkoutUrl is string
        && o.checkoutUrl.matches('^https://payment-link-v3\\.ton\\.com\\.br/pl_[A-Za-z0-9_-]{8,80}$');
    }
    // Catálogo de checkout público, somente links Ton. Leitura para qualquer visitante;
    // edição exige token Firebase de administrador e formato estrito (1 a 3 ofertas, cada plano uma vez).
    match /publicCatalog/plans {
      allow read: if true;
      allow create, update: if autorizado()
        && request.resource.data.keys().hasOnly(['offers', 'updatedAt'])
        && request.resource.data.keys().hasAll(['offers', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.offers is list
        && request.resource.data.offers.size() >= 1
        && request.resource.data.offers.size() <= 3
        && ofertaValida(request.resource.data.offers[0])
        && (request.resource.data.offers.size() < 2 || (ofertaValida(request.resource.data.offers[1])
              && request.resource.data.offers[1].plan != request.resource.data.offers[0].plan))
        && (request.resource.data.offers.size() < 3 || (ofertaValida(request.resource.data.offers[2])
              && request.resource.data.offers[2].plan != request.resource.data.offers[0].plan
              && request.resource.data.offers[2].plan != request.resource.data.offers[1].plan));
      allow delete: if false;
    }
    // Solicitações de exclusão da contingência: cada Firebase UID só acessa
    // seus próprios pedidos. Não concede permissão para apagar contas/dados.
    match /accountDeletionRequests/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'status', 'requestedAt', 'confirmation'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.confirmation == 'SOLICITAR EXCLUSÃO'
        && request.resource.data.requestedAt == request.time;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }
    match /mirrors/{email}/{document=**} {
      allow read, write: if minhaPasta(email);
    }
    match /workspaces/main/{document=**} {
      allow read, write: if autorizado();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
