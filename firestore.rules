rules_version = '2';

// Espelho do Shakstory: cada usuário só enxerga e grava a própria pasta,
// e somente se entrou com o e-mail autorizado (verificado pelo Google).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'antonyopintor@gmail.com';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
